<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ClipNest</AssemblyName>
    <RootNamespace>ClipNest.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ClipNest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipNest.Core\ClipNest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ClipNest.ico" />
    <Resource Include="Assets\TrayActive.ico" />
    <Resource Include="Assets\TrayPaused.ico" />
  </ItemGroup>

</Project>
