<Window x:Class="ClipNest.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipNest"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <Grid Margin="14">
        <Border CornerRadius="12" Background="{DynamicResource PanelBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="12" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="20,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="InputBox" Style="{StaticResource InputBox}" Margin="0,14,0,0" Visibility="Collapsed"
                         MaxLength="200" AutomationProperties.Name="Title" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel"
                            IsCancel="True" MinWidth="88" Click="OnCancel" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="OK"
                            IsDefault="True" MinWidth="88" Margin="8,0,0,0" Click="OnConfirm" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
