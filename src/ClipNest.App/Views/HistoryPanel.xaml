<Window x:Class="ClipNest.App.Views.HistoryPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipNest clipboard history"
        Width="460" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="OnPanelPreviewKeyDown" Deactivated="OnPanelDeactivated">

    <!-- the outer margin leaves room for the shadow -->
    <Grid x:Name="Chrome" Margin="14">
        <Border CornerRadius="12" Background="{DynamicResource PanelBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.32" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="12,10,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0" Margin="2,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="Clipboard" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Button Grid.Column="2" Style="{StaticResource StatusPill}" Margin="0,0,6,0"
                            Command="{Binding ToggleCaptureCommand}"
                            ToolTip="Pause or resume saving new copies"
                            AutomationProperties.Name="{Binding CaptureLabel, StringFormat='Capture is {0}. Click to change.'}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CaptureLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings" AutomationProperties.Name="Settings" />
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;"
                            Command="{Binding CloseCommand}"
                            ToolTip="Close (Esc)" AutomationProperties.Name="Close" />
                </Grid>

                <!-- search -->
                <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding SearchHint}"
                         AutomationProperties.Name="Search clipboard history" />

                <!-- filters -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,6"
                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter" Content="All"
                                 IsChecked="{Binding IsFilterAll}" AutomationProperties.Name="Show all items" />
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter" Content="Text"
                                 IsChecked="{Binding IsFilterText}" AutomationProperties.Name="Show text only" />
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter" Content="Images"
                                 IsChecked="{Binding IsFilterImages}" AutomationProperties.Name="Show images only" />
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter" Content="Pinned"
                                 IsChecked="{Binding IsFilterPinned}" AutomationProperties.Name="Show pinned items only" />
                </StackPanel>

                <!-- notices: paused capture and short messages -->
                <StackPanel Grid.Row="3">
                    <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,2,0,4"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Capture is paused. New copies are not being saved." TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningForegroundBrush}" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Resume"
                                    Foreground="{DynamicResource WarningForegroundBrush}" Command="{Binding ToggleCaptureCommand}" />
                        </Grid>
                    </Border>

                    <Border x:Name="NoticeBar" CornerRadius="8" Padding="10,7" Margin="0,2,0,4"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoticeIsWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource InfoForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoticeIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                    Content="&#xE711;" Command="{Binding DismissNoticeCommand}"
                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss message" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- the list and its loading, empty and error states -->
                <Grid Grid.Row="4">
                    <ListBox x:Name="HistoryList"
                             ItemsSource="{Binding ItemsView}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource HistoryItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.Name="Clipboard history"
                             ScrollViewer.ScrollChanged="OnListScrollChanged"
                             MouseDoubleClick="OnListDoubleClick"
                             PreviewTextInput="OnListTextInput">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="6,8,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" Background="Transparent"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" Tag="&#xE8C8;" InputGestureText="Enter"
                                                      Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding PinActionName}" Tag="{Binding PinGlyph}" InputGestureText="Ctrl+P"
                                                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Rename pin…" Tag="&#xE8AC;" InputGestureText="F2"
                                                      IsEnabled="{Binding IsPinned}"
                                                      Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="View as code" Tag="&#xE943;" InputGestureText="Ctrl+E"
                                                      IsEnabled="{Binding IsText}"
                                                      Command="{Binding PlacementTarget.Tag.PreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Delete" Tag="&#xE74D;" InputGestureText="Del"
                                                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- left: kind badge or image thumbnail -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7" Margin="0,0,10,0"
                                            VerticalAlignment="Top" Background="{DynamicResource ThumbnailBackgroundBrush}">
                                        <Grid>
                                            <TextBlock x:Name="KindIcon" Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,44,44" RadiusX="7" RadiusY="7" />
                                                </Image.Clip>
                                            </Image>
                                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       ToolTip="The image file is missing"
                                                       Visibility="{Binding ThumbnailMissing, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>

                                    <!-- middle: title, preview and details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding HasPinTitle, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding PinTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="38" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                                   Visibility="{Binding ShowPreviewText, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- right: actions, shown on hover or when selected -->
                                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                Margin="6,0,0,0" Visibility="Hidden">
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE8C8;"
                                                ToolTip="Copy (Enter)" AutomationProperties.Name="Copy"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="{Binding PinGlyph}"
                                                ToolTip="{Binding PinActionName}" AutomationProperties.Name="{Binding PinActionName}"
                                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource DangerIconButton}" Width="28" Height="28" FontSize="13" Content="&#xE74D;"
                                                ToolTip="Delete" AutomationProperties.Name="Delete"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter TargetName="KindIcon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- loading -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="Loading history…" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- empty -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding EmptyTitle}" Margin="0,10,0,4" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding EmptyDetail}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- error -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="Could not load history" Margin="0,10,0,4" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Try again" Margin="0,12,0,0"
                                HorizontalAlignment="Center" Command="{Binding RetryCommand}" />
                    </StackPanel>
                </Grid>

                <!-- footer -->
                <Grid Grid.Row="5" Margin="2,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FooterText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="Clipboard history is saved unencrypted in your local app data folder." />
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Clear history"
                            Command="{Binding ClearHistoryCommand}"
                            ToolTip="Delete all unpinned items" AutomationProperties.Name="Clear unpinned history" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
