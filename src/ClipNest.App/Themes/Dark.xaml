<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- dark theme colors. controls refer to these keys with dynamic resources -->
    <Color x:Key="ShadowColor">#000000</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#17181D" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1D23" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#30323C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#25262E" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2D2F38" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#363946" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2A3552" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#6C8CFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7C9CFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#94AEFF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0E1020" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8ABB8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A7E8C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2C35" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A8A" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF97A4" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3A3222" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#F2C66D" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#1F2A44" />
