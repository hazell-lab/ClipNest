    <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="#121318" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#141519" />
    <SolidColorBrush x:Key="CodeLineNumberBrush" Color="#5D6170" />
    <SolidColorBrush x:Key="CodeKeywordBrush" Color="#C59BFF" />
